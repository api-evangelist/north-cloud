                  "description": "(Required) North.Cloud account identifier scoping the request."
                },
                {
                  "disabled": false,
                  "key": "costUnitId",
                  "value": "<string>",
                  "description": "(Required) Identifier combining business unit and cost unit (for example `bu-123:cu-456`)."
