        {
          "id": "70178950-eca6-4f7b-9b9f-9fc2ca479a6a",
          "name": "Update cost unit data",
          "request": {
            "name": "Update cost unit data",
            "description": {
              "content": "Updates an existing cost unit with new metric data points. By default new data points are merged with existing data; pass `replace=true` to overwrite the cost unit data set entirely.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "public",
                "cost-units"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "account_number",
                  "value": "<string>",
                  "description": "(Required) North.Cloud account identifier scoping the request."
                },
                {
                  "disabled": false,
                  "key": "replace",
                  "value": "false",
                  "description": "When true, replaces the cost unit's data set instead of merging."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"costUnitId\": \"<string>\",\n  \"data\": [\n    {\n      \"date\": \"<date>\",\n      \"metric\": \"<string>\"\n    },\n    {\n      \"date\": \"<date>\",\n      \"metric\": \"<string>\"\n    }\n  ]\n}",
