  "info": {
    "_postman_id": "36b56ec2-3fa4-4b36-a5b5-293691b88d26",
    "name": "North.Cloud Public Cost Units API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The North.Cloud Public API enables programmatic access to push and retrieve cost unit data for FinOps and cloud cost optimization workflows across AWS and GCP. Cost units combine business units and cost identifiers to track metric values over time, supporting unit economics, allocation, and chargeback reporting.\n\nContact Support:\n Name: North.Cloud Support",
      "type": "text/plain"
    }
